#!/usr/bin/env bash
# potato — potato 시리즈 단일 게이트웨이 CLI
# 레지스트리(projects.json) 하나로 모든 프로젝트를 동일한 규칙으로 생성/조회/접근한다.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REG="$ROOT/projects.json"
WORKSPACE="${POTATO_WORKSPACE:-$(dirname "$ROOT")}"
OWNER="$(jq -r .owner "$REG")"
MAIN="$(jq -r .defaultBranch "$REG")"

die() { echo "error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "'$1' 필요"; }
names() { jq -r '.projects[].name' "$REG"; }
exists() { jq -e --arg n "$1" '.projects[] | select(.name==$n)' "$REG" >/dev/null; }

usage() {
  cat <<USAGE
usage: potato <command> [args]

  list                       등록된 프로젝트 목록
  new <name> [desc] [tags]   템플릿으로 GitHub repo 생성 + 레지스트리 등록 (tags: a,b)
  add <name> [desc]          기존 repo를 레지스트리에만 등록
  clone [name]               워크스페이스로 clone (이름 생략 시 전체)
  sync                       전체 프로젝트 clone/pull
  status                     전체 프로젝트 브랜치/변경 상태
  feature <name> <topic>     프로젝트에 feature/<topic> 브랜치 생성
  open <name>                GitHub 페이지 URL 출력
  build                      게이트웨이 페이지 데이터(site/projects.json) 갱신

workspace: $WORKSPACE  (POTATO_WORKSPACE로 변경)
USAGE
}

register() { # name desc tags
  exists "$1" && die "'$1' 이미 등록됨"
  local tags; tags="$(jq -cn --arg t "${3:-}" '$t | split(",") | map(select(length>0))')"
  jq --arg n "$1" --arg d "${2:-}" --argjson t "$tags" \
    '.projects += [{name:$n, description:$d, status:"active", tags:$t}] | .projects |= sort_by(.name)' \
    "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"
  echo "registered: $1"
}

cmd_list() {
  jq -r '.projects[] | "\(.name)\u001f\(.status)\u001f\(.tags|join(","))\u001f\(.description)"' "$REG" | while IFS=$'\x1f' read -r n s t d; do printf '%-28s %-8s %-16s %s\n' "$n" "$s" "$t" "$d"; done
}

cmd_new() {
  local name="${1:?name 필요}" desc="${2:-}" tags="${3:-}"
  [[ "$name" == potato-* ]] || die "이름은 'potato-' 접두사 규칙을 따른다"
  exists "$name" && die "'$name' 이미 등록됨"
  need gh
  local dir="$WORKSPACE/$name"
  [[ -e "$dir" ]] && die "$dir 이미 존재"

  mkdir -p "$dir"
  cp -r "$ROOT/template/." "$dir/"
  sed -i "s/{{name}}/$name/g; s/{{description}}/${desc//\//\\/}/g" "$dir/README.md"
  git -C "$dir" init -q -b "$MAIN"
  git -C "$dir" add -A
  git -C "$dir" commit -qm "chore: bootstrap from potato template"
  gh repo create "$OWNER/$name" --public --description "$desc" --source "$dir" --push
  gh api -X PUT "repos/$OWNER/$name/branches/$MAIN/protection" --input - >/dev/null <<JSON || echo "warn: branch protection 실패(권한/플랜 확인)"
{"required_status_checks":null,"enforce_admins":false,
 "required_pull_request_reviews":{"required_approving_review_count":0},
 "restrictions":null}
JSON
  gh api -X PATCH "repos/$OWNER/$name" -F delete_branch_on_merge=true \
    -F allow_squash_merge=true -F allow_merge_commit=false -F allow_rebase_merge=false >/dev/null
  register "$name" "$desc" "$tags"
  echo "done: https://github.com/$OWNER/$name  →  potato-55min-projects에 projects.json 변경을 커밋하세요"
}

cmd_add() { register "${1:?name 필요}" "${2:-}" ""; }

clone_one() {
  local dir="$WORKSPACE/$1"
  if [[ -d "$dir/.git" ]]; then
    git -C "$dir" pull --ff-only -q && echo "pulled: $1" || echo "skip(pull 실패): $1"
  else
    git clone -q "https://github.com/$OWNER/$1.git" "$dir" && echo "cloned: $1"
  fi
}

cmd_clone() {
  if [[ -n "${1:-}" ]]; then exists "$1" || die "미등록: $1"; clone_one "$1"
  else for n in $(names); do clone_one "$n"; done; fi
}

cmd_status() {
  for n in $(names); do
    local dir="$WORKSPACE/$n"
    if [[ -d "$dir/.git" ]]; then
      printf '%-30s %-30s %s\n' "$n" "$(git -C "$dir" branch --show-current)" \
        "$(git -C "$dir" status --porcelain | wc -l | tr -d ' ') changed"
    else printf '%-30s %s\n' "$n" "(not cloned)"; fi
  done
}

cmd_feature() {
  local name="${1:?name 필요}" topic="${2:?topic 필요}" dir="$WORKSPACE/$1"
  [[ -d "$dir/.git" ]] || die "먼저 clone: potato clone $name"
  git -C "$dir" fetch -q origin "$MAIN"
  git -C "$dir" switch -c "feature/$topic" "origin/$MAIN"
}

cmd_open() { exists "${1:?name 필요}" || die "미등록: $1"; echo "https://github.com/$OWNER/$1"; }

cmd_build() { mkdir -p "$ROOT/site"; cp "$REG" "$ROOT/site/projects.json"; echo "built: site/projects.json"; }

need jq
case "${1:-}" in
  list|new|add|clone|status|feature|open|build) c="$1"; shift; "cmd_$c" "$@" ;;
  sync) cmd_clone ;;
  *) usage ;;
esac
